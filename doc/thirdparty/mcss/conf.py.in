DOXYFILE = 'Doxyfile'
## mcss-specific options
## according to https://mcss.mosra.cz/documentation/doxygen/

MAIN_PROJECT_URL = "@PROJECT_URL@/"

LINKS_NAVBAR1    = [
    ("Modules", 'modules', []),
    ("Pages",   'pages',   [])
]

LINKS_NAVBAR2    = [
    ("Namespaces", 'namespaces', []),
    ("Classes",    'annotated',  []),
    ("Files",      'files',      []),
]

## custom, not m.css
my_CUSTOM_STYLESHEET = '@CUSTOM_STYLESHEET@'

## Reset custom stylesheet only if it was explicitly defined
if not my_CUSTOM_STYLESHEET=='':
    STYLESHEETS = [
        'https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,400i,600,600i%7CSource+Code+Pro:400,400i,600',
        my_CUSTOM_STYLESHEET
    ]

