/* inspired by: https://stackoverflow.com/a/9179152 */

/*  SNPT_sm_*: special members, copy + move ctors and ops + destructor   */

/**
 * \class SNPT_sm_default_ctor
 *
 * \brief Default constructor
 */

/**
 * \class SNPT_sm_copy_ctor
 *
 * \brief Copy constructor.
 *
 * \param[in] rhs The instance to copy
 */

/**
 * \class SNPT_sm_copy_op
 *
 * \brief Copy assignment operator.
 *
 * \param[in] rhs The instance to copy
 *
 * \return Reference to the instance with the value assigned
 */

/**
 * \class SNPT_sm_move_ctor
 *
 * \brief Move constructor.
 *
 * \param[in] rhs The instance to move
 */

/**
 * \class SNPT_sm_move_op
 *
 * \brief Move assignment operator.
 *
 * \param[in] rhs The instance to move
 *
 * \return Reference to the instance with the value assigned
 */

/**
 * \class SNPT_sm_default_dtor
 *
 * \brief Default destructor.
 */


/* =====  SNPT_mf_*: member functions and member operators  ===== */

/* virtual */

/**
 * \class SNPT_mf_clone
 *
 * \brief Return a deep copy of the instance
 *
 * \return A deep copy of the instance
 */

/* non-virtual */

/**
 * \class SNPT_mf_op_bool_if_empty
 *
 * \brief Return \c TRUE iff the instance is not empty(), otherwise \c FALSE.
 *
 * \return \c TRUE iff instance is not empty(), otherwise \c FALSE
 */

/**
 * \class SNPT_mf_op_bool_if_zero
 *
 * \brief Return \c TRUE iff the instance is not zero(), otherwise \c FALSE.
 *
 * \return \c TRUE iff instance is not zero(), otherwise \c FALSE
 */

/**
 * \class SNPT_mf_size
 *
 * \brief Return the number of elements contained in the instance.
 *
 * \return Number of elements contained in the instance
 */

/**
 * \class SNPT_mf_empty
 *
 * \brief Return \c TRUE iff the instance is empty, otherwise \c FALSE.
 *
 * \return \c TRUE iff the instance is empty, otherwise \c FALSE
 */

/**
 * \class SNPT_mf_zero
 *
 * \brief Return \c TRUE iff the value of this instance is equivalent to 0.
 *
 * \return \c TRUE if the value of this instance is 0, otherwise \c FALSE
 */

/**
 * \class SNPT_mf_swap
 *
 * \brief Swap this instance with \c rhs.
 *
 * \param[in] rhs Instance to swap
 */

/**
 * \class SNPT_mf_equals
 *
 * \brief Return \c TRUE iff the instance is equal to \c rhs otherwise \c FALSE.
 *
 * \param[in] rhs Instance to check for equality
 *
 * \return \c TRUE iff \c this is equal to \c rhs, otherwise \c FALSE
 */

/**
 * \class SNPT_mf_to_string
 *
 * \brief Create a string representation of this instance.
 *
 * \return String representation of this instance
 */

/**
 * \class SNPT_mf_begin
 *
 * \brief Provide an iterator to the first element.
 *
 * \return An iterator to the first element.
 */

/**
 * \class SNPT_mf_cbegin
 *
 * \brief Provide a const_iterator to the first element.
 *
 * \return A const_iterator to the first element.
 */

/**
 * \class SNPT_mf_cend
 *
 * \brief Provide a const_iterator pointing behind the last element.
 *
 * \return A const_iterator pointing behind the last element.
 */

/**
 * \class SNPT_mf_crbegin
 *
 * \brief Provide a reverse const_iterator pointing to the last element.
 *
 * \return A reverse const_iterator pointing to the last element.
 */

/**
 * \class SNPT_mf_crend
 *
 * \brief Provide a reverse const_iterator pointing before the first element.
 *
 * \return A reverse const_iterator pointing before the first element.
 */

/**
 * \class SNPT_mf_end
 *
 * \brief Provide an iterator pointing behind the last element.
 *
 * \return An iterator pointing behind the last element.
 */

/**
 * \class SNPT_mf_rbegin
 *
 * \brief Provide a reverse iterator pointing to the last element.
 *
 * \return A reverse iterator pointing to the last element.
 */

/**
 * \class SNPT_mf_rend
 *
 * \brief Provide a reverse iterator pointing before the first element.
 *
 * \return A reverse iterator pointing before the first element.
 */


/* =====  SNPT_tp_*: typedefs  ===== */

/**
 * \class SNPT_tp_value
 *
 * \brief Type of the values provided
 */

/**
 * \class SNPT_tp_key
 *
 * \brief Type of the keys used for value access
 */

/**
 * \class SNPT_tp_size
 *
 * \brief Type of the size of this class
 */

/**
 * \class SNPT_tp_iterator
 *
 * \brief Type of iterator
 */

/**
 * \class SNPT_tp_const_iterator
 *
 * \brief Type of constant iterator
 */

/**
 * \class SNPT_tp_reverse_iterator
 *
 * \brief Type of reverse iterator
 */

/**
 * \class SNPT_tp_reverse_const_iterator
 *
 * \brief Type of constant reverse iterator
 */

/**
 * \class SNPT_tp_pointer
 *
 * \brief Type of pointer to element
 */

/**
 * \class SNPT_tp_reference
 *
 * \brief Type of reference to element
 */

/**
 * \class SNPT_tp_difference
 *
 * \brief Type of iterator difference
 */

